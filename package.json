{
  "name": "@crafter-cms/cli",
  "version": "1.0.2",
  "description": "Crafter CMS CLI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "crafter": "./bin/run.js"
  },
  "files": [
    "/bin",
    "/dist",
    "/templates",
    "/oclif.manifest.json"
  ],
  "scripts": {
    "build": "shx rm -rf dist && tsc -b",
    "postpack": "shx rm -f oclif.manifest.json",
    "posttest": "npm run lint",
    "prepack": "npm run build && npx oclif manifest",
    "test": "echo \"Error: no test specified\" && exit 1",
    "version": "git add README.md"
  },
  "author": "Crafter CMS",
  "license": "Apache-2.0",
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@oclif/core": "^4.1.0",
    "archiver": "^8.0.0",
    "axios": "^1.7.9",
    "chalk": "^4.1.2",
    "chokidar": "^5.0.0",
    "cli-table3": "^0.6.5",
    "form-data": "^4.0.5",
    "fs-extra": "^11.3.0",
    "glob": "^13.0.6",
    "http-proxy": "^1.18.1",
    "jwt-decode": "^4.0.0",
    "open": "^11.0.0",
    "ora": "^5.4.1",
    "semver": "^7.7.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@oclif/test": "^4.1.0",
    "@types/archiver": "^8.0.0",
    "@types/form-data": "^2.2.1",
    "@types/fs-extra": "^11.0.4",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^20.0.0",
    "@types/semver": "^7.5.8",
    "@types/ws": "^8.18.1",
    "shx": "^0.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  },
  "oclif": {
    "bin": "crafter",
    "dirname": "crafter",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "config": {
        "description": "Manage theme-kit configuration"
      }
    }
  }
}
